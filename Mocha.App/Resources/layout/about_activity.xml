<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="center_vertical"
    android:gravity="center_horizontal"
    android:background="@color/backgroundOpaque"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:scrollbarFadeDuration="0">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:padding="@dimen/marginSizeLarge">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/buttonSizeStd"
            android:layout_height="@dimen/buttonSizeStd"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside"
            android:background="@drawable/image_round_shape"
            android:contentDescription="@string/vendorName"
            android:tooltipText="@string/vendorName"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/appName"
            android:textAlignment="center"
            android:textStyle="bold"
            style="@android:style/TextAppearance.Large"
            android:layout_marginTop="@dimen/marginSizeSmall"/>
        <TextView
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            style="@android:style/TextAppearance.Small"/>
        <TextView
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            style="@android:style/TextAppearance.Small"
            android:layout_marginTop="@dimen/marginSizeSmall2"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/buttonSizeStd"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/marginSizeLarge">
            <TextView
                android:id="@+id/link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vendorDomain"
                android:textAlignment="center"
                style="@android:style/TextAppearance.Small"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
