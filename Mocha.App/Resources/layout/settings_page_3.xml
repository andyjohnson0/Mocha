<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/marginSizeMedium">
    <ImageView
        android:id="@+id/infoImg"
        android:layout_width="@dimen/buttonSizeStd"
        android:layout_height="@dimen/buttonSizeStd"
        android:src="@drawable/ic_info_outline_large"
        android:scaleType="center"
        android:contentDescription="@string/information"
        android:tooltipText="@string/information"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/informationTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/information"
        style="@android:style/TextAppearance.Small"
        android:textStyle="bold"
        android:singleLine="false"
        android:maxLines="2"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="full"
        app:layout_constraintLeft_toRightOf="@id/infoImg"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/websiteLinkDescriptionTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/aboutThisApp"
        style="@android:style/TextAppearance.Small"
        android:gravity="top"
        android:singleLine="false"
        android:maxLines="2"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="full"
        app:layout_constraintLeft_toRightOf="@id/infoImg"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/informationTxt" />
</androidx.constraintlayout.widget.ConstraintLayout>
