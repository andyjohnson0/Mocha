<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/buttonSizeStd"
    android:background="@drawable/ripple_background_selector"
    app:layout_constraintHeight_min="@dimen/buttonSizeStd">
    <TextView
        android:id="@+id/methodName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@android:style/TextAppearance.Medium"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingLeft="@dimen/marginSizeSmall2"
        app:layout_constraintEnd_toStartOf="@+id/metgodBrewTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/methodBrewTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@android:style/TextAppearance.Medium"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingRight="@dimen/marginSizeSmall2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/methodName"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
