<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/marginSizeMedium">
    <ImageView
        android:id="@+id/alarmSoundImg"
        android:layout_width="@dimen/buttonSizeStd"
        android:layout_height="@dimen/buttonSizeStd"
        android:src="@drawable/ic_volume_up_large"
        android:scaleType="center"
        android:contentDescription="@string/alarmSound"
        android:tooltipText="@string/alarmSound"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/alarmSoundTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/alarmSound"
        style="@android:style/TextAppearance.Small"
        android:textStyle="bold"
        android:singleLine="false"
        android:maxLines="2"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="full"
        app:layout_constraintLeft_toRightOf="@id/alarmSoundImg"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/alarmSoundSw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/alarmSoundImg"
        app:layout_constraintTop_toBottomOf="@id/alarmSoundTxt" />
</androidx.constraintlayout.widget.ConstraintLayout>
