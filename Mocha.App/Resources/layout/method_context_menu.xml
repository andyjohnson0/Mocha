<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout 
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="0.5">
        <ImageButton
            android:id="@+id/editBtn"
            android:layout_width="@dimen/buttonSizeStd"
            android:layout_height="@dimen/buttonSizeStd"
            android:src="@drawable/ic_edit_large"
            android:background="@drawable/button_round_states"
            android:scaleType="center"
            android:contentDescription="@string/edit"
            android:tooltipText="@string/edit"/>
        <Space
            android:layout_width="@dimen/marginSizeMedium"
            android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/deleteBtn"
            android:layout_width="@dimen/buttonSizeStd"
            android:layout_height="@dimen/buttonSizeStd"
            android:src="@drawable/ic_delete_large"
            android:background="@drawable/button_round_states"
            android:scaleType="center"
            android:contentDescription="@string/delete"
            android:tooltipText="@string/delete"/>
        <Space
            android:layout_width="@dimen/marginSizeMedium"
            android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/addBtn"
            android:layout_width="@dimen/buttonSizeStd"
            android:layout_height="@dimen/buttonSizeStd"
            android:src="@drawable/ic_add_large"
            android:background="@drawable/button_round_states"
            android:scaleType="center"
            android:contentDescription="@string/add"
            android:tooltipText="@string/add"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
