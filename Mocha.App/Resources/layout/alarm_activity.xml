<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarmLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundOpaque">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/coffeeReadyMsg"
        android:textStyle="bold"
        style="@android:style/TextAppearance.Large"
        android:singleLine="false"
        android:maxLines="2"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="full"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <ImageButton
        android:id="@+id/okButton"
        android:layout_width="@dimen/buttonSizeStd"
        android:layout_height="@dimen/buttonSizeStd"
        android:scaleType="center"
        android:src="@drawable/ic_done"
        android:background="@drawable/button_round_states"
        android:backgroundTint="@color/colorAccent"
        android:contentDescription="@string/done"
        android:tooltipText="@string/done"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/marginSizeMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
