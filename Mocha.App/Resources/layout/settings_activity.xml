<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/backgroundOpaque"
    android:gravity="center_vertical"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:scrollbarFadeDuration="0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/marginSizeMedium"
        android:paddingRight="@dimen/marginSizeMedium"
        android:paddingTop="@dimen/marginSizeLarge2"
        android:paddingBottom="@dimen/marginSizeLarge2">

        <include layout="@layout/settings_page_0"/>
        <include layout="@layout/settings_page_1"/>
        <include layout="@layout/settings_page_2"/>
        <include layout="@layout/settings_page_3"/>

    </LinearLayout>

</ScrollView>
