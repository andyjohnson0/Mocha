<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/_countdownContainer"
        app:layout_constraintHeight_min="@dimen/buttonSizeStd"
        app:layout_constraintWidth_percent="0.7">
        <TextView
            android:id="@+id/methodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            style="@android:style/TextAppearance.Medium"
            android:singleLine="false"
            android:maxLines="2"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="full"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@drawable/ripple_background_selector"
            android:paddingLeft="@dimen/rippleHorizTextPadding"
            android:paddingRight="@dimen/rippleHorizTextPadding"
            android:paddingTop="@dimen/rippleVertTextPadding"
            android:paddingBottom="@dimen/rippleVertTextPadding"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/_countdownContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="@dimen/buttonSizeStd"
            android:layout_height="@dimen/buttonSizeStd"
            android:src="@drawable/ic_settings_small"
            android:scaleType="center"
            android:background="@drawable/button_round_states"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:contentDescription="@string/settings"
            android:tooltipText="@string/settings"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/buttonSizeStd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:id="@+id/timerCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                style="@android:style/TextAppearance.Large"
                android:layout_gravity="center_horizontal|center_vertical"
                android:background="@drawable/ripple_background_selector"
                android:paddingLeft="@dimen/rippleHorizTextPadding"
                android:paddingRight="@dimen/rippleHorizTextPadding"
                android:paddingTop="@dimen/rippleVertTextPadding"
                android:paddingBottom="@dimen/rippleVertTextPadding"/>
        </FrameLayout>
        <ImageButton
            android:id="@+id/methodMenuBtn"
            android:layout_width="@dimen/buttonSizeStd"
            android:layout_height="@dimen/buttonSizeStd"
            android:src="@drawable/ic_navigate_next_small"
            android:scaleType="center"
            android:contentDescription="@string/more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:tooltipText="@string/more"
            android:background="@drawable/button_round_states"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/startStopButton"
        android:layout_width="@dimen/buttonSizeStd"
        android:layout_height="@dimen/buttonSizeStd"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/_countdownContainer"
        android:scaleType="center"
        android:background="@drawable/button_round_states"
        android:backgroundTint="@color/colorAccent"
        android:contentDescription="@string/startStop"
        android:tooltipText="@string/startStop"/>

</androidx.constraintlayout.widget.ConstraintLayout>
